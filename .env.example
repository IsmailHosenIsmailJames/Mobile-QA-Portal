# ==============================================================================
# Rewardly Test Hub & Release Portal Environment Configuration
# ==============================================================================

# Authentication & Security
PORTAL_API_KEY=rewardly_qa_secret_key_2026
DASHBOARD_PASSWORD=

# Base Portal Public URL (used for QR codes and deep links)
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000

# Storage Provider Configuration
# Options: 'local' (development/default), 'vercel_blob', or 's3'
STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=

# AWS / Cloudflare R2 S3-Compatible Storage (Optional)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=rewardly-artifacts
S3_PUBLIC_DOMAIN=

# Remote GitHub Actions Integration (Optional)
# Used by "Run Tests" modal to trigger remote runner
GITHUB_TOKEN=
GITHUB_REPO_OWNER=rolality
GITHUB_REPO_NAME=Rewardly
GITHUB_WORKFLOW_ID=run-integration-tests.yml

# Local Runner Webhook (Optional fallback if running tests on local ADB machine)
LOCAL_RUNNER_WEBHOOK_URL=
